# =============================================================================
# ResumeIQ Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required secrets before running.
# Note: Users bring their own Gemini API key in Profile -> API Key.
# No global GEMINI_API_KEY is required on the server (except optional DEMO_MODE).

# --- Core Security (REQUIRED) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret-key

# 32-byte URL-safe base64 Fernet key for encrypting user Gemini API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-valid-fernet-key=

# --- Database & Cache ---
# In Docker Compose, use postgres and redis hostnames:
# DATABASE_URL=postgresql+psycopg://resumeiq:resumeiq@postgres:5432/resumeiq
# REDIS_URL=redis://redis:6379/0
# For local development without Docker, SQLite works out of the box:
DATABASE_URL=sqlite:///./resumeiq_dev.db
REDIS_URL=
TASK_RUNNER=inline

# --- GitHub Integration (Public Repos Only) ---
# Personal access token with NO scopes (public_repo read-only) for higher rate limits (5000 req/hr).
# Create at: https://github.com/settings/tokens (Fine-grained or classic with no private scopes)
GITHUB_TOKEN=

# --- LLM Configuration ---
# Provider: gemini (default) or anthropic
LLM_PROVIDER=gemini
# Verified Google Gemini model IDs (https://ai.google.dev/gemini-api/docs/models)
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_QUALITY_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional Anthropic fallback if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Per-user daily call limit and token budgets
PER_USER_DAILY_LLM_LIMIT=100
LLM_MAX_INPUT_CHARS=24000

# --- Demo Mode ---
# Set to true to use deterministic saved LLM responses without external API calls
DEMO_MODE=false

# --- Optional Google OAuth (Disabled unless GOOGLE_CLIENT_ID is set) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Job Extraction Options ---
# Optional third-party scraper (off by default)
THIRD_PARTY_SCRAPER_ENABLED=false
THIRD_PARTY_SCRAPER_URL=
THIRD_PARTY_SCRAPER_KEY=
JOB_CACHE_TTL_HOURS=24

# --- App URLs & CORS ---
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ENVIRONMENT=development
UPLOAD_DIR=./storage/uploads
OUTPUT_DIR=./storage/outputs
